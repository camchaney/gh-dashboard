{
  "manifest_version": 3,
  "name": "GitHub Dashboard",
  "version": "0.1.0",
  "description": "Quick access to your pinned GitHub repositories.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/login/*"]
}
